{
  "name": "fit-score",
  "version": "0.1.0",
  "description": "Pontua a adesão de uma vaga a um perfil por critérios explícitos de uma rubrica YAML, com explicação por critério.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:api": "tsx watch src/server/main.ts",
    "dev:web": "vite",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json && vite build",
    "start": "node dist/server/main.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "fastify": "^5.12.8",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
